{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mimu-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  // One Worker serves both: the PWA as static assets, and the API under /api.
  // Only /api/* runs Worker code; everything else is served straight from the built PWA.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Secrets (set with `wrangler secret put`, or apps/api/.dev.vars locally):
  // TURSO_DATABASE_URL, TURSO_AUTH_TOKEN, MIMU_ACCESS_KEY
  // The hosted demo adds TURSO_PLATFORM_TOKEN, TURSO_ORG, TURSO_GROUP_TOKEN, MIMU_ACCOUNTS_DB_URL, and optionally
  // TURSO_GROUP, MIMU_DEMO_MAX_ACCOUNTS, GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET (see scripts/hosted-setup.ts).
  // Daily sweep that deletes demo accounts unused for 30 days. Does nothing on a single-user install.
  "triggers": { "crons": ["17 9 * * *"] },
  "observability": { "enabled": true }
}
