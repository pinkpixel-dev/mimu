{
  "name": "@mimu/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @mimu/web build && wrangler dev",
    "dev:local": "tsx scripts/local.ts",
    "deploy": "pnpm --filter @mimu/web build && wrangler deploy",
    "migrate": "tsx scripts/migrate.ts",
    "quickstart": "tsx scripts/quickstart.ts",
    "hosted-setup": "tsx scripts/hosted-setup.ts",
    "typecheck": "tsc -p .",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@mimu/shared": "workspace:*",
    "fflate": "^0.8.3",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@hono/node-server": "^2.1.5",
    "@types/node": "^22.19.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.3"
  }
}
