# Copy this to apps/api/.dev.vars (gitignored) and fill it in.
# `pnpm quickstart` writes the first three for you, and `wrangler deploy --secrets-file .dev.vars`
# uploads everything in .dev.vars as Worker secrets.

# Your Turso database: URL starts with libsql://
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# The key that opens your Mimu. Generate one with: openssl rand -hex 32
MIMU_ACCESS_KEY=

# Hosted demo (optional). Leave these out for a normal single-user install.
# Mint the platform token with `turso auth api-tokens mint <name>`, then run
# `pnpm --filter @mimu/api hosted-setup` to fill in the rest.
TURSO_PLATFORM_TOKEN=
TURSO_ORG=
TURSO_GROUP=default
TURSO_GROUP_TOKEN=
MIMU_ACCOUNTS_DB_URL=
MIMU_DEMO_MAX_ACCOUNTS=50

# GitHub sign-in for the hosted demo (optional). OAuth app callback URL:
# https://<your-domain>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Push notifications (optional): the morning digest and reminders on your phone.
# Run `pnpm --filter @mimu/api vapid` to generate these. Don't change the keys later, or devices stop getting
# notifications until they turn them on again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=
