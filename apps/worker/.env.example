# Copy to apps/worker/.env and fill in.

# Mimu API: your Cloudflare Worker URL plus /api (https://mimu-api.<you>.workers.dev/api),
# or http://127.0.0.1:8788 for the local API
MIMU_API_URL=
# Same value as MIMU_ACCESS_KEY in apps/api/.dev.vars
MIMU_ACCESS_KEY=

# Optional
# OLLAMA_HOST=http://127.0.0.1:11434
# MIMU_MODEL=gemma4:e4b
# MIMU_INTERVAL_MINUTES=60
# MIMU_ASK_POLL_SECONDS=3
# Hour (0-23, this computer's clock) when the morning digest is written. Default 8.
# MIMU_DIGEST_HOUR=8
# MIMU_POLL_SECONDS=10
# MIMU_BATCH_SIZE=5
