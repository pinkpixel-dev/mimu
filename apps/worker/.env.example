# Copy to apps/worker/.env and fill in.

# Mimu API (the Cloudflare Worker URL, or http://127.0.0.1:8788 for the local API)
MIMU_API_URL=
# Same value as MIMU_ACCESS_KEY in apps/api/.dev.vars
MIMU_ACCESS_KEY=

# Optional
# OLLAMA_HOST=http://127.0.0.1:11434
# MIMU_MODEL=gemma4:e4b
# MIMU_INTERVAL_MINUTES=60
# MIMU_POLL_SECONDS=60
# MIMU_BATCH_SIZE=5
