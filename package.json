{
  "name": "mimu",
  "version": "0.1.0",
  "private": true,
  "description": "Speak a thought, and a local AI sorts it into searchable Markdown notes.",
  "license": "Apache-2.0",
  "author": "Pink Pixel <admin@pinkpixel.dev> (https://pinkpixel.dev)",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "pnpm --filter @mimu/web dev",
    "dev:api": "pnpm --filter @mimu/api dev",
    "migrate": "pnpm --filter @mimu/api migrate",
    "worker": "pnpm --filter @mimu/worker start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  }
}
